# Copy this file to .env and fill in the values you need.

# ---- YOLO ----
# Tillgängliga modeller (laddas ner automatiskt vid första användning):
# yolo11n/s/m/l/x.pt, yolo26n/s/m/l/x.pt
YOLO_MODEL=yolo11n.pt
YOLO_CONF=0.30
# Inference device: cpu | 0 (NVIDIA CUDA) | openvino:GPU (Intel iGPU, needs openvino)
YOLO_DEVICE=cpu

# ---- Small vision LLM (Ollama) ----
LLM_BACKEND=ollama          # ollama | none
OLLAMA_MODEL=moondream      # moondream (~1.9B) or llava (~7B) — `ollama pull moondream`
OLLAMA_URL=http://localhost:11434

# ---- Home Assistant: MQTT + auto-discovery (recommended) ----
HA_ENABLED=1
HA_TRANSPORT=mqtt
HA_CAMERA_ID=cam1
HA_MQTT_HOST=192.168.1.10
HA_MQTT_PORT=1883
HA_MQTT_USER=
HA_MQTT_PASS=

# ---- Larmstyrd LLM-laddning (HA-alarm): skarpt = ladda LLM, av = plocka ut ----
# HA_ALARM_TOPIC=homeassistant/alarm_control_panel/+/state
# OLLAMA_KEEP_ALIVE_ARMED=-1     # -1 = haller LLM laddad medan larmet ar skarpt
# OLLAMA_KEEP_ALIVE_DISARMED=0   # 0  = plockar ut LLM direkt nar larmet ar av

# ---- Home Assistant: REST (alternative to MQTT) ----
#HA_ENABLED=1
#HA_TRANSPORT=rest
#HA_REST_URL=http://192.168.1.10:8123
#HA_REST_TOKEN=

# ---- Reolink camera (reolink_motion.py) ----
#REOLINK_HOST=192.168.1.20
#REOLINK_USER=admin
#REOLINK_PASS=

# ---- Live-kamera (Reolink RTSP -> YOLO -> Dashboard) ----
# Alla nycklar har defaultvärden - en gammal .env utan dem fungerar.
# GUI-first: ändras normalt i webb-GUI:t under Inställningar -> Kamera.
CAMERA_ENABLED=false
CAMERA_NAME=Garden
# CAMERA_HOST/CAMERA_USER/CAMERA_PASS faller tillbaka på REOLINK_* ovan
CAMERA_HOST=192.168.1.20
CAMERA_USER=admin
CAMERA_PASS=
CAMERA_PATH=/Preview_01_sub
# Full RTSP-URL som override (sätts den används istället för HOST/USER/PASS/PATH):
#CAMERA_RTSP_URL=rtsp://user:pass@192.168.1.20/Preview_01_sub
CAMERA_RECONNECT=true
CAMERA_RECONNECT_DELAY=5
CAMERA_AUTOSTART=

# ---- Live YOLO-schemaläggning ----
YOLO_STREAM_FPS=4          # AI FPS (hur ofta YOLO analyserar livebilden)
YOLO_IMG_SIZE=640          # 320/480/640/960/1280

# ---- Live-ström (MJPEG till webbläsare) ----
LIVE_STREAM_ENABLED=true
LIVE_STREAM_FPS=10         # display-FPS
LIVE_JPEG_QUALITY=80       # 20-100
LIVE_SHOW_BOXES=true
LIVE_SHOW_LABELS=true
LIVE_SHOW_CONF=true
