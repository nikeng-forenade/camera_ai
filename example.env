# Copy this file to .env and fill in the values you need.

# ---- YOLO ----
YOLO_MODEL=yolo11n.pt
YOLO_CONF=0.50
# Inference device: cpu | 0 (NVIDIA CUDA) | openvino:GPU (Intel iGPU, needs openvino)
YOLO_DEVICE=cpu

# ---- Small vision LLM (Ollama) ----
LLM_BACKEND=ollama          # ollama | none
OLLAMA_MODEL=moondream      # moondream (~1.9B) or llava (~7B) — `ollama pull moondream`
OLLAMA_URL=http://localhost:11434

# ---- Home Assistant: MQTT + auto-discovery (recommended) ----
HA_ENABLED=1
HA_TRANSPORT=mqtt
HA_CAMERA_ID=cam1
HA_MQTT_HOST=192.168.1.10
HA_MQTT_PORT=1883
HA_MQTT_USER=
HA_MQTT_PASS=

# ---- Home Assistant: REST (alternative to MQTT) ----
#HA_ENABLED=1
#HA_TRANSPORT=rest
#HA_REST_URL=http://192.168.1.10:8123
#HA_REST_TOKEN=

# ---- Reolink camera (reolink_motion.py) ----
#REOLINK_HOST=192.168.1.20
#REOLINK_USER=admin
#REOLINK_PASS=
